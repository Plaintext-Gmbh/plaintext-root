    <build>
        <pluginManagement>
            <plugins>
            <!--
              Karte 365 (fuer plaintext-app in 358 bereits so geloest): sonar-maven-plugin explizit
              deklariert, ohne Execution — es laeuft nur, wenn die Pipeline `sonar:sonar` aufruft.
              Ohne diese Deklaration muss Maven den Prefix `sonar` ueber <pluginGroups> aus einer
              settings.xml aufloesen; auf den NAS-Runnern fehlt die settings.xml (Container-Neuanlage),
              seit dem 20.07.2026 scheiterte die woechentliche Voll-Analyse deshalb mit
              "No plugin found for prefix 'sonar'". Folge: Das Quality-Gate konnte sich nie mehr selbst
              zuruecksetzen und meldete ein eingefrorenes "OK" — schlimmer als ein rotes Gate, weil es
              wie ein bestandener Check aussieht.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.14</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- JaCoCo Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      Soft coverage gate: surfaces dropping coverage in the build
                      log but does NOT fail the build (haltOnFailure=false). Once
                      every module hits the BUNDLE LINE 0.40 floor consistently we
                      can flip haltOnFailure to true. See
                      docs/IMPROVEMENT_PROPOSALS.md (DX § "JaCoCo coverage gate").
                    -->
                    <execution>
                        <id>coverage-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>false</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Implementation-Version im Jar-Manifest statt Platzhalter "dev" (root Modul-Verwaltung Phase 2). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Dual-Publish: Releases gehen zusaetzlich zu GitHub Packages (distributionManagement,
             id "plaintext" — fuer Builds AUSSERHALB des LANs, z.B. Nacht-Runner-Mac) auch ins private
             NAS-Maven-Repo (Reposilite, LAN-only). BEWUSST als Profil mit Property-Aktivierung statt
             direkt in build/plugins: die Consumer (app/iot/schuetu/fwtool) erben diesen Parent —
             eine vererbte Execution wuerde dort zum Doppel-Upload in ihr eigenes plaintext-nas-Repo
             fuehren. Aktiviert wird das Profil NUR im root-Repo via .mvn/maven.config
             (-Droot.dual.publish=true); Credentials liefert die CI-settings.xml. -->
        <profile>
            <id>dual-publish-nas</id>
            <activation>
                <property>
                    <name>root.dual.publish</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>deploy-nas</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>deploy</goal>
                                </goals>
                                <configuration>
                                    <altDeploymentRepository>plaintext-nas::https://maven.plaintext.ch/releases</altDeploymentRepository>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

