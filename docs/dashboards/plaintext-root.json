{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "process_uptime_seconds{application=\"plaintext-root\"}",
          "legendFormat": "uptime"
        }
      ],
      "options": { "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"plaintext-root\",area=\"heap\"})",
          "legendFormat": "heap used"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"plaintext-root\",area=\"heap\"})",
          "legendFormat": "heap max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 1 }
    },
    {
      "type": "timeseries",
      "title": "GC pause time",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"plaintext-root\"}[5m])",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 }
    },

    {
      "type": "row",
      "title": "HTTP traffic",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Request rate (RPS)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"plaintext-root\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"plaintext-root\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"plaintext-root\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 }
    },

    {
      "type": "row",
      "title": "Database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }
    },
    {
      "type": "timeseries",
      "title": "Hikari connection pool",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"plaintext-root\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"plaintext-root\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_max{application=\"plaintext-root\"}",
          "legendFormat": "max"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 }
    },
    {
      "type": "stat",
      "title": "Flyway migrations executed",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "flyway_migrations_executed_total{application=\"plaintext-root\"}",
          "legendFormat": "migrations"
        }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 27 }
    },

    {
      "type": "row",
      "title": "Login & security",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }
    },
    {
      "type": "timeseries",
      "title": "Requests on /login and /logout",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"plaintext-root\",uri=~\"/login.*|/logout\"}[5m])) by (uri, status)",
          "legendFormat": "{{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["plaintext", "spring-boot", "starter"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "title": "Plaintext Root — Starter",
  "uid": "plaintext-root-starter",
  "version": 1
}
