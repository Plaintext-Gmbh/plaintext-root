<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.plaintext</groupId>
        <artifactId>plaintext-root-parent</artifactId>
        <version>1.664.0</version>
    </parent>

    <artifactId>plaintext-admin-requirements</artifactId>
    <name>plaintext-admin-requirements</name>
    <description>Requirements management module for plaintext-boot</description>

    <dependencies>
        <!-- Plaintext modules -->
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-interfaces</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-menu</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JSF / PrimeFaces -->
        <dependency>
            <groupId>org.joinfaces</groupId>
            <artifactId>primefaces-spring-boot-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Swagger/OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Geteilte Architektur-Regeln (siehe <build>): dieses Modul haengt NICHT an
             plaintext-root-webapp, deshalb sieht der dortige ArchUnit-Lauf seine Klassen nicht. -->
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-archtests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Zustandsbericht 29.08.2026, Etappe 2: Die klassenbasierten Arch-Regeln aus
                 plaintext-root-archtests (ArchUnit, Basispaket ch.plaintext) laufen in root nur in
                 plaintext-root-webapp — und die haengt nicht an diesem Modul. Drei Session-Beans
                 hier hielten deshalb unbemerkt nicht-transiente Repositories/Dienste; aufgefallen
                 ist es erst in plaintext-app, wo alle root-Jars auf dem Classpath liegen.
                 Darum faehrt dieses Modul die klassenbasierten Regeln selbst (wie ein Consumer);
                 die dateibasierten Linter (Header, JSF-View, Facelets-EL, Mobile, ...) scannen
                 den ganzen Reactor ohnehin aus der webapp heraus und laufen hier nicht doppelt.
                 PlaintextArchitectureTest bleibt draussen: seine Regeln betreffen @Scheduled und
                 PlaintextCron, beides gibt es hier nicht, und ArchUnit wertet eine Regel ohne
                 passende Klassen als Fehler (failOnEmptyShould).
                 Die Deckung bewacht SessionBeanRegelDeckungTest in plaintext-root-webapp. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>geteilte-arch-regeln</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>ch.plaintext:plaintext-root-archtests</dependency>
                            </dependenciesToScan>
                            <!-- PlaintextLayeringTest (Massnahme 12) gehoert dazu: er liest die
                                 target/classes der Module des Reactors, und dieses Modul wird NACH
                                 plaintext-root-webapp gebaut — im webapp-Lauf eines sauberen Builds
                                 gibt es seine Klassen also noch nicht. Ohne diesen Eintrag bliebe
                                 plaintext-admin-requirements ungeprueft, genau wie zuvor beim
                                 Session-Bean-Test. -->
                            <test>PlaintextSessionBeanSerialisierbarTest,PlaintextMcpScopeVertragTest,PlaintextLayeringTest</test>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
