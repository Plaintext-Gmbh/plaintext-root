<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.plaintext</groupId>
        <artifactId>plaintext-root-parent</artifactId>
        <version>1.794.0-SNAPSHOT</version>
    </parent>

    <artifactId>plaintext-root-files</artifactId>
    <name>plaintext-root-files</name>
    <description>Persoenliche Dateiablage mit Freigabe-Links (Karte 1559, aus dem Inventar): Port DateiSpeicher, Links ueber LinkTokenStore</description>

    <dependencies>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-interfaces</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-menu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-pageguard</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Standard-LinkTokenStore (JPA). Eine Anwendung mit eigenem Store kann das Modul ausschliessen. -->
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-freigabe</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.joinfaces</groupId>
            <artifactId>primefaces-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!-- MCP-Werkzeuge: optional wie in plaintext-root-freigabe; das Bean haengt an @ConditionalOnClass. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <version>2.0.2</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.plaintext</groupId>
            <artifactId>plaintext-root-archtests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Das Modul haengt (bewusst) nicht in plaintext-root-webapp: nicht jede Anwendung soll eine
                 Dateiablage bekommen. Die klassenbasierten Arch-Regeln laufen deshalb hier selbst, wie in
                 plaintext-admin-requirements (SessionBeanRegelDeckungTest bewacht das). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>geteilte-arch-regeln</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <dependenciesToScan>
                                <dependency>ch.plaintext:plaintext-root-archtests</dependency>
                            </dependenciesToScan>
                            <test>PlaintextSessionBeanSerialisierbarTest,PlaintextMcpScopeVertragTest,PlaintextLayeringTest,PlaintextModulgrenzenTest</test>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
