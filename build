#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# ── Load shared libraries ────────────────────────────────────
SCRIPTS_DIR="$HOME/codeplain/plaintext-scripts"
if [ ! -f "$SCRIPTS_DIR/tui-common.sh" ]; then
    echo "plaintext-scripts not found, cloning to $SCRIPTS_DIR..."
    git clone git@github.com:Plaintext-Gmbh/plaintext-scripts.git "$SCRIPTS_DIR"
fi
source "$SCRIPTS_DIR/tui-common.sh"
source "$SCRIPTS_DIR/tui-build-logic.sh"

# ── Initialize versions ──────────────────────────────────────
init_versions

# ── Spiegelung ins git-basierte Maven-Repo ───────────────────
#
# WARUM
# Die Releases gehen ueber distributionManagement nach GitHub Packages. Deren
# Maven-Registry verlangt aber bei JEDER Anfrage HTTP-Basic-Auth, auch bei
# oeffentlichen Paketen (`www-authenticate: Basic realm="GitHub Package Registry"`).
# Anders als bei ghcr.io gibt es dafuer keinen Schalter. Eine konsumierende App
# braucht also ein Token mit `read:packages`, nur um eine oeffentliche Bibliothek zu
# holen - fuer eine offene Produktlinie ist das die falsche Huerde.
#
# Plaintext-Gmbh/plaintext-mvn ist deshalb als git-basiertes Maven-Repository
# angelegt: raw.githubusercontent.com liefert oeffentliche Dateien ohne jede
# Anmeldung aus. Der README dieses Repos beschreibt genau diesen Bezugsweg. Nur
# befuellt hat ihn bisher niemand - deshalb diese Funktion.
#
# NUR ROOT SPIEGELT
# Die Konsumenten (app/iot/schuetu/fwtool) erben zwar diesen Parent, rufen aber
# ihr eigenes ./build. Diese Funktion steht bewusst hier und nicht in
# plaintext-scripts/tui-build-logic.sh, damit ausschliesslich root in dieses
# Repository schreibt - dieselbe Ueberlegung wie beim Profil dual-publish-nas.
mirror_to_plaintext_mvn() {
    local version klon stage m2 modul verzeichnis anzahl

    # Die Version kommt aus dem Tag, NICHT aus dem POM: do_release hebt die
    # POM-Version am Ende auf den naechsten SNAPSHOT. Ein help:evaluate an dieser
    # Stelle liefert also bereits 1.494.0-SNAPSHOT, waehrend soeben 1.493.0
    # veroeffentlicht wurde.
    version="${1:-$(git describe --tags --abbrev=0 2>/dev/null)}"

    case "$version" in
        ""|*-SNAPSHOT)
            echo -e "${YELLOW}plaintext-mvn: '${version:-kein Tag gefunden}' ist kein Release - uebersprungen.${NC}"
            return 0
            ;;
    esac

    if [ -z "${GITHUB_TOKEN:-}" ]; then
        echo -e "${YELLOW}plaintext-mvn: kein GITHUB_TOKEN - Spiegelung uebersprungen.${NC}"
        return 0
    fi

    m2="${HOME}/.m2/repository/ch/plaintext"
    if [ ! -d "$m2" ]; then
        echo -e "${RED}plaintext-mvn: $m2 fehlt - lief das Release wirklich durch?${NC}"
        return 1
    fi

    klon="$(mktemp -d)"

    echo -e "${BLUE}=== Spiegele $version nach Plaintext-Gmbh/plaintext-mvn ===${NC}"

    # --depth 1 genuegt: deploy-file liest nur den Arbeitsbaum, um die vorhandene
    # maven-metadata.xml um die neue Version zu ergaenzen.
    if ! git clone --quiet --depth 1 \
            "https://x-access-token:${GITHUB_TOKEN}@github.com/Plaintext-Gmbh/plaintext-mvn.git" "$klon"; then
        echo -e "${RED}plaintext-mvn: Klonen fehlgeschlagen.${NC}"
        return 1
    fi

    # Die Artefakte liegen nach dem Release fertig im lokalen Repository. Sie von
    # dort zu uebernehmen statt neu zu bauen, spart einen kompletten zweiten
    # Reaktor-Durchlauf - und stellt sicher, dass exakt die veroeffentlichten
    # Dateien gespiegelt werden und nicht ein zweites, leicht abweichendes Build.
    #
    # deploy-file pflegt dabei die maven-metadata.xml je Artefakt fort; genau die
    # braucht ein Konsument, um "neueste Version" zu bestimmen.
    # Umweg ueber ein Staging-Verzeichnis: deploy-file weigert sich, eine Datei zu
    # veroeffentlichen, die im lokalen Repository liegt ("Cannot deploy artifact
    # from the local repository"). Kopieren ist billiger als neu bauen.
    stage="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$klon' '$stage'" RETURN

    anzahl=0
    for verzeichnis in "$m2"/*/"$version"; do
        [ -d "$verzeichnis" ] || continue
        modul="$(basename "$(dirname "$verzeichnis")")"
        [ -f "$verzeichnis/$modul-$version.pom" ] || continue

        cp "$verzeichnis/$modul-$version.pom" "$stage/" || return 1
        if [ -f "$verzeichnis/$modul-$version.jar" ]; then
            cp "$verzeichnis/$modul-$version.jar" "$stage/" || return 1
            mvn -q org.apache.maven.plugins:maven-deploy-plugin:deploy-file \
                -Durl="file://$klon" -DrepositoryId=plaintext-mvn \
                -Dfile="$stage/$modul-$version.jar" \
                -DpomFile="$stage/$modul-$version.pom" -DgeneratePom=false || return 1
        else
            # Parent- und BOM-Artefakte haben kein JAR.
            mvn -q org.apache.maven.plugins:maven-deploy-plugin:deploy-file \
                -Durl="file://$klon" -DrepositoryId=plaintext-mvn \
                -Dfile="$stage/$modul-$version.pom" \
                -DpomFile="$stage/$modul-$version.pom" \
                -Dpackaging=pom -DgeneratePom=false || return 1
        fi
        anzahl=$((anzahl + 1))
    done

    if [ "$anzahl" -eq 0 ]; then
        echo -e "${RED}plaintext-mvn: keine Artefakte fuer $version in $m2 gefunden.${NC}"
        return 1
    fi

    (
        cd "$klon" || exit 1
        git add -A ch || exit 1
        if git diff --cached --quiet; then
            echo "plaintext-mvn: keine Aenderung - nichts zu committen."
            exit 0
        fi
        git -c user.name="plaintext-ci" -c user.email="ci@plaintext.ch" \
            commit --quiet -m "Release $version" || exit 1
        git push --quiet origin HEAD:master || exit 1
    ) || {
        echo -e "${RED}plaintext-mvn: Commit/Push fehlgeschlagen.${NC}"
        return 1
    }

    echo -e "${GREEN}plaintext-mvn: $anzahl Artefakte fuer $version veroeffentlicht.${NC}"
    return 0
}

# ── Command execution (digit dispatch) ───────────────────────

execute_command() {
    local CMD="$1"

    case "$CMD" in
        0)
            exec "$0" run
            ;;
        1)
            exec "$0" build
            ;;
        2)
            exec "$0" release 1
            ;;
        3)
            exec "$0" release
            ;;
        4)
            exec "$0" release 3
            ;;
        5)
            exec "$0" release deploy-healthcheck
            ;;
        6)
            exec "$0" deploy-prod-healthcheck
            ;;
        7)
            do_release "deploy-healthcheck"
            deploy_to_prod "true" || exit 1
            ;;
        8)
            # Lokal-Release: Release + Tag + Blue-Green PROD direkt, ohne CI (do_local_release)
            exec "$0" local-release
            ;;
        *)
            echo -e "${RED}Invalid option: ${CMD}${NC}"
            exit 1
            ;;
    esac
}

# ── Non-interactive mode (arguments provided) ────────────────

COMMAND=$1

if [ -n "$COMMAND" ]; then
    # Twingate handling: only stop as last resort in ensure_nas_reachable()
    # Restart on exit if it was stopped during NAS connectivity check
    trap 'restart_twingate_if_needed' EXIT

    # Check if command is a sequence of digits/s (multi-command execution)
    if [[ "$COMMAND" =~ ^[0-9s]+$ ]] && [ ${#COMMAND} -gt 1 ]; then
        echo -e "${BLUE}=== Executing command sequence: ${COMMAND} ===${NC}"

        for (( i=0; i<${#COMMAND}; i++ )); do
            DIGIT="${COMMAND:$i:1}"
            echo -e "${YELLOW}=== Step $((i+1))/${#COMMAND}: Executing command ${DIGIT} ===${NC}"

            "$0" "$DIGIT"
            EXIT_CODE=$?

            if [ $EXIT_CODE -ne 0 ]; then
                echo -e "${RED}=== Command ${DIGIT} failed with exit code ${EXIT_CODE} ===${NC}"
                echo -e "${RED}=== Stopping command sequence ===${NC}"
                exit $EXIT_CODE
            fi

            echo -e "${GREEN}=== Command ${DIGIT} completed successfully ===${NC}"
            echo ""
        done

        echo -e "${GREEN}=== All commands completed successfully! ===${NC}"
        exit 0
    fi

    case "$COMMAND" in
        0)
            exec "$0" run
            ;;

        1)
            exec "$0" build
            ;;

        2)
            exec "$0" release 1
            ;;

        3)
            exec "$0" release
            ;;

        4)
            exec "$0" release 3
            ;;

        5)
            exec "$0" release deploy-healthcheck
            ;;

        6)
            exec "$0" deploy-prod-healthcheck
            ;;

        7)
            do_release "deploy-healthcheck"
            deploy_to_prod "true" || exit 1
            ;;
        8)
            # Lokal-Release: Release + Tag + Blue-Green PROD direkt, ohne CI (do_local_release)
            exec "$0" local-release
            ;;

        help|-h|--help)
            show_usage
            exit 0
            ;;

        run)
            do_run || exit 1
            ;;

        build)
            do_build_snapshot "$2" || exit 1
            ;;

        release)
            do_release "$2" "$3" || exit 1
            # Erst nach erfolgreichem Release spiegeln. Schlaegt die Spiegelung
            # fehl, ist das Release trotzdem gueltig (GitHub Packages und NAS sind
            # bedient) - deshalb nur eine Warnung statt exit 1. Ein fehlgeschlagener
            # Spiegel darf keinen Prod-Deploy verhindern, der danach kommt.
            mirror_to_plaintext_mvn || echo -e "${YELLOW}Spiegelung nach plaintext-mvn fehlgeschlagen - Release bleibt gueltig.${NC}"
            ;;

        mirror-mvn)
            mirror_to_plaintext_mvn "$2" || exit 1
            ;;

        deploy-prod)
            deploy_to_prod || exit 1
            ;;

        deploy-prod-healthcheck)
            deploy_to_prod "true" || exit 1
            ;;

        local-release)
            # $2 = 1|2|3 (Increment), $3 = prod|dev-prod (Ziel) — Details in tui-build-logic.sh
            do_local_release "$2" "$3" || exit 1
            ;;

        s|sonar)
            do_sonar || exit 1
            ;;

        setup-bluegreen)
            setup_blue_green || exit 1
            ;;

        *)
            echo -e "${RED}Unknown command: ${COMMAND}${NC}"
            echo ""
            show_usage
            exit 1
            ;;
    esac

    echo -e "${BLUE}Done!${NC}"
    exit 0
fi

# ── TUI (Interactive Mode) ───────────────────────────────────

# Menu items - parallel arrays for bash 3.2 compat
MENU_LABELS=()
MENU_LABELS+=("Build + Run (local)")
MENU_LABELS+=("Build (snapshot)")
MENU_LABELS+=("Release (major)")
MENU_LABELS+=("Release (minor)")
MENU_LABELS+=("Release (patch)")
MENU_LABELS+=("Release + Deploy DEV")
MENU_LABELS+=("Deploy Release to PROD")
MENU_LABELS+=("Release + Deploy DEV + PROD")
MENU_LABELS+=("Lokal-Release -> PROD (Tag + Blue-Green, ohne CI)")
MENU_TOTAL=${#MENU_LABELS[@]}
MENU_MAX_IDX=$((MENU_TOTAL - 1))

CURSOR=0

tui_init
trap tui_cleanup EXIT

draw() {
    # top(1) + band(3) + version(2) + sep(1) + blank(1) + items(MENU_TOTAL) + blank(1) + sep(1) + footer(1) + bottom(1)
    local total_height=$((1 + 3 + 2 + 1 + 1 + MENU_TOTAL + 1 + 1 + 1 + 1))

    tput clear
    tui_center $total_height

    # ── Top border ──
    tui_hline "┌" "─" "┐"

    # ── Blue band (3 lines: space, title, space) ──
    tui_nr; tui_band_row
    tui_nr; tui_band_title "${TUI_TITLE}"
    tui_nr; tui_band_row

    # ── Version info ──
    tui_nr; tui_row "  Version: ${CURRENT_VERSION}" "${FG_CYAN}"
    tui_nr; tui_row "  Release: ${RELEASE_VERSION:-n/a}" "${FG_CYAN}"

    # ── Separator ──
    tui_nr; tui_hline "├" "─" "┤"

    # ── Empty line before items ──
    tui_nr; tui_row "" ""

    # ── Menu items ──
    local i
    for ((i=0; i<MENU_TOTAL; i++)); do
        tui_nr
        if [[ $CURSOR -eq $i ]]; then
            tui_item_on "${MENU_LABELS[$i]}"
        else
            tui_item_off "${MENU_LABELS[$i]}"
        fi
    done

    # ── Empty line after items ──
    tui_nr; tui_row "" ""

    # ── Footer separator ──
    tui_nr; tui_hline "├" "─" "┤"

    # ── Footer help ──
    tui_nr; tui_row "  ↑↓ Navigate  ENTER Ausführen  H Help  Q Quit" "${FG_DIM}"

    # ── Bottom border ──
    tui_nr; tui_hline "└" "─" "┘"
}

show_help() {
    local total_height=19

    tput clear
    tui_center $total_height

    tui_hline "┌" "─" "┐"
    tui_nr; tui_row "" ""
    tui_nr; tui_row "  ${TUI_TITLE} - HELP" "${FG_WHITE}${BOLD}"
    tui_nr; tui_row "" ""
    tui_nr; tui_hline "├" "─" "┤"
    tui_nr; tui_row "  Tastatur:" "${FG_CYAN}${BOLD}"
    tui_nr; tui_row "    ↑ ↓       Navigieren" "${FG_CYAN}"
    tui_nr; tui_row "    ENTER     Auswahl ausfuehren" "${FG_CYAN}"
    tui_nr; tui_row "    0-8       Direkte Auswahl" "${FG_CYAN}"
    tui_nr; tui_row "    Q         Beenden" "${FG_CYAN}"
    tui_nr; tui_row "" ""
    tui_nr; tui_row "  CLI:" "${FG_CYAN}${BOLD}"
    tui_nr; tui_row "    ./build run       Bauen + Starten" "${FG_CYAN}"
    tui_nr; tui_row "    ./build 1         Snapshot Build" "${FG_CYAN}"
    tui_nr; tui_row "    ./build 56        Multi-Command" "${FG_CYAN}"
    tui_nr; tui_row "    ./build 8         Lokal-Release -> PROD (ohne CI)" "${FG_CYAN}"
    tui_nr; tui_row "" ""
    tui_nr; tui_hline "├" "─" "┤"
    tui_nr; tui_row "  Beliebige Taste zum Schliessen..." "${FG_DIM}"
    tui_nr; tui_hline "└" "─" "┘"
    IFS= read -rsn1
}

# ── Main loop ─────────────────────────────────────────────────

draw

while true; do
    IFS= read -rsn1 key

    case "$key" in
        $'\x1b')
            # Escape sequence: read remaining chars
            read -rsn2 -t 1 seq || seq=""
            case "$seq" in
                '[A') # Up
                    [[ $CURSOR -gt 0 ]] && CURSOR=$((CURSOR - 1))
                    ;;
                '[B') # Down
                    [[ $CURSOR -lt $MENU_MAX_IDX ]] && CURSOR=$((CURSOR + 1))
                    ;;
            esac
            ;;
        '') # Enter key
            tui_cleanup
            echo ""
            execute_command "$CURSOR"
            exit 0
            ;;
        [0-8])
            # Number shortcut
            tui_cleanup
            echo ""
            execute_command "$key"
            exit 0
            ;;
        'q'|'Q')
            tui_cleanup
            echo ""
            exit 0
            ;;
        'h'|'H'|'?')
            show_help
            ;;
    esac

    draw
done
